# Jupiter - Variables de entorno
# Copiar a .env antes de ejecutar: cp .env.example .env

# ============ Ollama ============
# URL base de Ollama (usar nombre servicio en Docker: ollama)
OLLAMA_URL=http://ollama:11434
# Modelo LLM para generación de respuestas (ligero para RAG local)
OLLAMA_MODEL=llama3.2:1b
# Modelo para generar embeddings de texto
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Timeout en segundos para llamadas a Ollama (generación, embeddings)
OLLAMA_TIMEOUT=120

# ============ Qdrant ============
# Host de Qdrant (usar nombre servicio en Docker: qdrant)
QDRANT_HOST=qdrant
# Puerto de Qdrant
QDRANT_PORT=6333

# ============ PostgreSQL ============
# Host de PostgreSQL (usar nombre servicio en Docker: postgres)
POSTGRES_HOST=postgres
# Puerto de PostgreSQL
POSTGRES_PORT=5432
# Usuario de la base de datos
POSTGRES_USER=jupiter
# Contraseña (cambiar en producción)
POSTGRES_PASSWORD=jupiter_secret
# Nombre de la base de datos
POSTGRES_DB=jupiter
# URL de conexión SQLAlchemy (se construye desde POSTGRES_* o definir manualmente)
DATABASE_URL=postgresql://jupiter:jupiter_secret@postgres:5432/jupiter

# ============ Storage ============
# Ruta donde se guardan los archivos subidos (dentro del contenedor)
STORAGE_PATH=/app/storage

# ============ API / Frontend ============
# URL del backend para CORS y llamadas desde el frontend (desarrollo: localhost)
API_URL=http://localhost:8000

# ============ Límites ============
# Tamaño máximo por archivo en MB
MAX_FILE_SIZE_MB=20
# Máximo de archivos por conversación
MAX_FILES_PER_CONVERSATION=50

# ============ RAG ============
# Número de chunks a recuperar en búsqueda semántica
RAG_TOP_K=5
# Tamaño de chunk en caracteres
RAG_CHUNK_SIZE=800
# Solapamiento entre chunks consecutivos
RAG_CHUNK_OVERLAP=100
# Ventana de historial de mensajes incluida en contexto del LLM
RAG_HISTORY_LIMIT=10

# ============ Logging ============
# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
